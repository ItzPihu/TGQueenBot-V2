    "@grammyjs/transformer-throttler": "latest",
    "axios": "latest",
    "canvas": "latest",
    "chalk": "latest",
    "fluent-ffmpeg": "latest",
    "grammy": "latest",
    "miniget": "latest",
    "moment": "latest",
